# Optional backend override (export this when running the Maven wrapper):
# PORT=8092
# Optional frontend proxy override (export this when running Vite):
# DEVOPSX_BACKEND_URL=http://127.0.0.1:8092
# Optional password for the local H2 database:
# DB_PASSWORD=choose-a-local-development-value

# Hosted backend only (set secrets in Render, never commit actual values):
# SPRING_PROFILES_ACTIVE=production,render
# DB_HOST=internal-postgres-host
# DB_PORT=5432
# DB_NAME=database-name
# DB_USERNAME=database-user
# DB_PASSWORD=managed-password
# SEED_DUMMY_CONTENT=true
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
